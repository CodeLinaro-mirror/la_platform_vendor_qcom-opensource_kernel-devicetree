/dts-v1/;
/plugin/;

#include "sa522m-adp.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. SA522 ADP Overlay";
	compatible = "qcom,sdxpinn-adp",
		"qcom,sdxpinn", "qcom,adp";
	qcom,board-id = <0x0010019 0x00>;
};

&qnand_1 {
	status = "ok";
};

&pcie0 {
	status = "disabled";
};

&pcie0_msi {
	status = "disabled";
};

&pcie1 {
	status = "disabled";
};

&pcie2 {
	status = "disabled";
};
