	mem_noc: interconnect@19100000 {
		reg = <0x19100000 0x2D080>;
		compatible = "qcom,sdxbaagha-mem_noc";
		#interconnect-cells = <1>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
