	dc_noc: interconnect@190E0000 {
		reg = <0x190E0000 0x5080>;
		compatible = "qcom,sdxbaagha-dc_noc";
		#interconnect-cells = <1>;
		qcom,bcm-voter-names = "hlos";
		qcom,bcm-voters = <&apps_bcm_voter>;
