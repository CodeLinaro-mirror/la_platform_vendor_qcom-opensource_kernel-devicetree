		compatible = "qcom,rmnet-ipa3";
		qcom,rmnet-ipa-ssr;
	};

	ipa_hw: qcom,ipa@3e00000 {
		compatible = "qcom,ipa";
		reg =
			<0x3e00000 0x84000>,
			<0x3e04000 0xfc000>;
		reg-names = "ipa-base", "gsi-base";
		qcom,ipa-cfg-offset = <0x0140000>;
		interrupts =
			<0 314 IRQ_TYPE_LEVEL_HIGH>,
			<0 208 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "ipa-irq", "gsi-irq";
		qcom,ipa-hw-ver = <23>; /* IPA core version = IPAv5.2 */
		qcom,ipa-hw-mode = <0>;
		qcom,platform-type = <0>; /* MDM platform */
		qcom,ee = <0>;
		qcom,entire-ipa-block-size = <0x200000>;
		qcom,use-ipa-tethering-bridge;
		qcom,mhi-event-ring-id-limits = <9 15>; /* start and end */
		qcom,modem-cfg-emb-pipe-flt;
		qcom,use-xbl-boot;
		qcom,ipa-wdi3-over-gsi;
		qcom,wlan-ce-db-over-pcie;
		qcom,wan-rx-ring-size = <96>;
		qcom,lan-rx-ring-size = <96>;
		qcom,arm-smmu;
		qcom,ipa-endp-delay-wa-v2;
		qcom,tx-wrapper-cache-max-size = <400>;
		qcom,ipa-gpi-event-rp-ddr;
		qcom,max_num_smmu_cb = <4>;
		clock-names = "core_clk";
		clocks = <&rpmhcc RPMH_IPA_CLK>;
		qcom,interconnect,num-cases = <5>;
		qcom,interconnect,num-paths = <3>;
		interconnects = <&aggre_noc MASTER_IPA &mem_noc SLAVE_LLCC>,
				<&mc_virt MASTER_LLCC &mc_virt SLAVE_EBI1>,
				<&mem_noc MASTER_APPSS_PROC &cnoc_main SLAVE_IPA_CFG>;
		interconnect-names = "ipa_to_llcc", "llcc_to_ebi1", "appss_to_ipa";
		/* No vote */
		qcom,no-vote =
		<0 0 0 0 0 0>;
		/* SVS2 */
		qcom,svs2 =
		<18000 0 590000 1900000 0 76800>;

		/* SVS */
		qcom,svs =
		<400000 0 1200000 2800000 0 150000>;

		/* NOMINAL */
		qcom,nominal =
		<670000 0 2400000 5500000 0 400000>;

		/* TURBO */
		qcom,turbo =
		<1380000 0 3600000 5500000 0 400000>;

		qcom,bus-vector-names = "MIN", "SVS2", "SVS", "NOMINAL",
			"TURBO";
		qcom,throughput-threshold = <600 2500 5000>;
		qcom,scaling-exceptions = <>;
		/* smp2p information */
		qcom,smp2p_map_ipa_1_out {
			compatible = "qcom,smp2p-map-ipa-1-out";
			qcom,smem-states = <&smp2p_ipa_1_out 0>;
			qcom,smem-state-names = "ipa-smp2p-out";
		};

		qcom,smp2p_map_ipa_1_in {
			compatible = "qcom,smp2p-map-ipa-1-in";
			interrupts-extended = <&smp2p_ipa_1_in 0 0>;
			interrupt-names = "ipa-smp2p-in";
		};

		ipa_smmu_ap: ipa_smmu_ap {
			compatible = "qcom,ipa-smmu-ap-cb";
			iommus = <&apps_smmu 0x000 0x0>;
			qcom,iommu-dma-addr-pool = <0x20000000 0x20000000>;
			qcom,additional-mapping =
				/* modem tables in IMEM */
				<0x14691000 0x14691000 0x2000>;
			qcom,iommu-dma = "atomic";
			qcom,ipa-q6-smem-size = <36864>;
		};

		ipa_smmu_wlan: ipa_smmu_wlan {
			compatible = "qcom,ipa-smmu-wlan-cb";
			iommus = <&apps_smmu 0x001 0x0>;
			qcom,iommu-dma = "atomic";
		};

		ipa_smmu_uc: ipa_smmu_uc {
			compatible = "qcom,ipa-smmu-uc-cb";
			iommus = <&apps_smmu 0x002 0x0>;
			qcom,iommu-dma-addr-pool = <0x20000000 0x20000000>;
			qcom,iommu-dma = "atomic";
		};

		ipa_smmu_11ad: ipa_smmu_11ad {
			compatible = "qcom,ipa-smmu-11ad-cb";
			iommus = <&apps_smmu 0x003 0x0>;
			qcom,shared-cb;
			qcom,iommu-group = <>;
		};
	};

	napa_vreg: napa_vreg {
		compatible = "qti-regulator-fixed";
		regulator-name = "napa_vreg";
		gpio = <&tlmm 108 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		enable-active-high;
		regulator-enable-ramp-delay = <80000>;
	};

	mtl_rx_setup: rx-queues-config {
		snps,rx-queues-to-use = <2>;
		snps,rx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			snps,map-to-dma-channel = <0x0>;
			snps,route-up;
			snps,priority = <0x1>;
		};

		queue1 {
			snps,dcb-algorithm;
			snps,map-to-dma-channel = <0x1>;
			snps,route-ptp;
		};

		queue2 {
			snps,avb-algorithm;
			snps,map-to-dma-channel = <0x2>;
			snps,route-avcp;
		};

		queue3 {
			snps,avb-algorithm;
			snps,map-to-dma-channel = <0x3>;
			snps,priority = <0xC>;
		};
	};

	mtl_tx_setup: tx-queues-config {
		snps,tx-queues-to-use = <2>;
		snps,tx-sched-sp;
		queue0 {
			snps,dcb-algorithm;
		};

		queue1 {
			snps,dcb-algorithm;
		};

		queue2 {
			snps,avb-algorithm;
			snps,send_slope = <0x1000>;
			snps,idle_slope = <0x1000>;
			snps,high_credit = <0x3E800>;
			snps,low_credit = <0xFFC18000>;
		};

		queue3 {
			snps,avb-algorithm;
			snps,send_slope = <0x1000>;
			snps,idle_slope = <0x1000>;
			snps,high_credit = <0x3E800>;
			snps,low_credit = <0xFFC18000>;
		};

	};

	ethqos_hw: qcom,ethernet@23040000 {
		compatible = "qcom,stmmac-ethqos", "snps,dwmac-4.20a";
		qcom,arm-smmu;
		reg = <0x23040000 0x10000>,
				<0x23056000 0x100>,
				<0x00FF6000 0xE10>;

		reg-names = "stmmaceth", "rgmii", "serdes";
		clocks = <&gcc GCC_EMAC0_AXI_CLK>,
				<&gcc GCC_EMAC0_SLV_AHB_CLK>,
				<&gcc GCC_EMAC0_PTP_CLK>,
				<&gcc GCC_EMAC0_PHY_AUX_CLK>,
				<&gcc GCC_EMAC_0_CLKREF_EN>;
		clock-names = "stmmaceth", "pclk", "ptp_ref", "phyaux", "sgmi_ref";
		snps,ptp-ref-clk-rate = <250000000>;
		snps,ptp-req-clk-rate = <96000000>;
		interrupts-extended = <&intc GIC_SPI 261 IRQ_TYPE_LEVEL_HIGH>;

		interrupt-names = "macirq";

		snps,tso;
		snps,pbl = <32>;
		snps,rxpbl = <16>;
		rx-fifo-depth = <8192>;
		tx-fifo-depth = <8192>;

		snps,mtl-rx-config = <&mtl_rx_setup>;
		snps,mtl-tx-config = <&mtl_tx_setup>;

		vreg_emac_phy-supply = <&napa_vreg>;

		gdsc_emac-supply = <&gcc_emac0_gdsc>;

		phy-mode = "sgmii";
		snps,reset-gpio = <&tlmm 97 1>;
		snps,reset-active-low;
		snps,reset-delays-us = <0 11000 70000>;
		pinctrl-names = "dev-emac-mdc",
				"dev-emac-mdio";

		pinctrl-0 = <&emac_mdc>;
		pinctrl-1 = <&emac_mdio>;

		snps,ps-speed = <1000>;
		managed = "auto";
		eth-c22-mdio-probe;
		snps,crc_strip;
		pcs-v3;
		sw-dma-tx-desc-cnt = <128>;
		sw-dma-rx-desc-cnt = <128>;

		interconnect-names = "axi_icc_path", "apb_icc_path";
		interconnects = <&aggre_noc MASTER_EMAC &mc_virt SLAVE_EBI1>,
				<&mem_noc MASTER_APPSS_PROC &cnoc_main SLAVE_EMAC_CFG>;

		ethqos_emb_smmu: ethqos_emb_smmu {
			compatible = "qcom,emac-smmu-embedded";
			iommus = <&apps_smmu 0x100 0xf>;
			qcom,iommu-dma = "fastmap";
			qcom,iommu-dma-addr-pool = <0x80000000 0x0FE40000>;
			qcom,iommu-geometry = <0x80000000 0x0FE40000>;
		};
	};
};

&firmware {
	qcom_scm {
		compatible = "qcom,scm";
		qcom,dload-mode = <&tcsr 0x13000>;
	};

	qtee_shmbridge {
		compatible = "qcom,tee-shared-memory-bridge";
		qcom,custom-bridge-size = <512>;
	};

	qcom_smcinvoke {
		compatible = "qcom,smcinvoke";
		qcom,support-legacy_smc;
	};
};

#include "ipcc-test-sdxbaagha.dtsi"
#include "sdxbaagha-pinctrl.dtsi"
#include "sdxbaagha-debug.dtsi"
#include "sdxbaagha-dma-heaps.dtsi"
#include "msm-arm-smmu-sdxbaagha.dtsi"
#include "sdxbaagha-pcie.dtsi"
#include "sdxbaagha-qupv3.dtsi"
#include "sdxbaagha-usb.dtsi"
#include "sdxbaagha-coresight.dtsi"
#include "sdxbaagha-pmic-overlay.dtsi"
#include "sdxbaagha-regulators.dtsi"

&qupv3_se3_2uart {
	status = "ok";
};

#include "sdxbaagha-thermal.dtsi"
