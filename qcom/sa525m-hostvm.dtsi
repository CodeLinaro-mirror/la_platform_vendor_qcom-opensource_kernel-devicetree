&ethqos_hw1 {
	iommus = <&apps_smmu 0x41 0x0>,
		 <&apps_smmu 0x42 0x0>,
		 <&apps_smmu 0x43 0x0>,
		 <&apps_smmu 0x44 0x0>,
		 <&apps_smmu 0x46 0x0>,
		 <&apps_smmu 0x49 0x0>,
		 <&apps_smmu 0x4A 0x0>,
		 <&apps_smmu 0x4B 0x0>,
		 <&apps_smmu 0x4C 0x0>;
};

&ipa_hw {
	gunyah-label = <10>;
	qcom,max_num_smmu_cb = <6>;

	/* Disable wlan2 on PVM for GVM v2x smmu cb to use peripheral 3 */
	ipa_smmu_wlan2 {
		status = "disabled";
	};
};
