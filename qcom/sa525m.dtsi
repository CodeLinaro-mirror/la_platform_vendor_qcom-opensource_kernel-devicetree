#include "sdxpinn.dtsi"
#include "sa525m-pmic-overlay.dtsi"

/ {
	aliases {
		spi6 = &qupv3_se6_spi;
		hsuart1 = &qupv3_se4_2uart;
		hsuart2 = &qupv3_se8_2uart;
	};
};

&qseecom_user_contig_heap {
	status = "disabled";
};

&user_contig_mem {
	status = "disabled";
};

&qnand_1 {
	status = "ok";
};

&qupv3_se5_i2c {
	status = "okay";
	asm330lhh@6b {
		compatible = "st,asm330lhh";
		reg = <0x6b>;
		pinctrl-names = "default";
		pinctrl-0 = <&sensor_int1_default>,<&sensor_int2_default>;
		interrupt-parent = <&tlmm>;
		interrupts = <109 IRQ_TYPE_EDGE_RISING>;
		st,drdy-int-pin= <2>;
		qcom,regulator_check = <0>;
		qcom,asm330_hrtimer;
	};

	asm330lhhx@6b {
		compatible = "st,asm330lhhx";
		reg = <0x6b>;
		pinctrl-names = "default";
		pinctrl-0 = <&sensor_int1_default>,<&sensor_int2_default>;
		interrupt-parent = <&tlmm>;
		interrupts = <109 IRQ_TYPE_EDGE_RISING>;
		st,int-pin= <2>;
		qcom,regulator_check = <0>;
		qcom,asm330_hrtimer;
	};
};

&qupv3_se4_2uart {
	status = "ok";
};

&qupv3_se8_2uart {
	status = "ok";
};


&ipa_hw {
	qcom,ipa-config-is-auto;
	qcom,ipa-wdi2_over_gsi;
	qcom,msm-bus,name = "ipa";
};

&tlmm {
	qcom,gpios-reserved = <>;
};

&soc {
	qcom,qrtr_gunyah_televm {
		compatible = "qcom,qrtr-gunyah";
		qcom,master;
		qcom,net-id = <0>;
		gunyah-label = <3>;
		peer-name = <5>;
	};

	qcom,qrtr_gunyah_fotavm {
		compatible = "qcom,qrtr-gunyah";
		qcom,master;
		qcom,net-id = <4>;
		gunyah-label = <9>;
		peer-name = <6>;
	};

	qmi-tmd-devices {
		modem {
			modem_v2x: modem_v2x {
				qcom,qmi-dev-name = "modem_v2x";
				#cooling-cells = <2>;
			};
		};
	};

	qmi-ts-sensors {
		modem {
			qcom,qmi-sensor-names = "sdr0",
						"sdr1",
						"sdr0_pa",
						"sdr1_pa",
						"mmw0",
						"mmw1",
						"mmw2",
						"mmw3",
						"mmw_ific0",
						"epm0",
						"epm1",
						"epm2",
						"epm3",
						"epm4",
						"epm5",
						"epm6",
						"epm7";
		};
	};

	pps {
		compatible = "pps-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pps>;
		gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&tlmm>;
		interrupts = <104 IRQ_TYPE_EDGE_RISING>;
		status = "okay";
	};

	mini_dump_mode {
		compatible = "qcom,minidump";
		status = "ok";
	};

	qcom,ext_clk {
		compatible = "qcom,clk-led-pwm";
		clocks = <&gcc GCC_TLMM_125_CLK>;
		clock-names = "core";
		assigned-clocks = <&gcc GCC_TLMM_125_CLK>;
		assigned-clock-rates = <125000000>;
		qcom,max_duty = <50>;
		pinctrl-names = "active", "sleep";
		pinctrl-0 = <&qcom_125_clk_active>;
		pinctrl-1 = <&qcom_125_clk_sleep>;
		status = "ok";
	};
};

&tmc_etr {
	sw_usb_buf_size = <0x400000>;
};

&tlmm {
	hsm-rst-hog {
		gpio-hog;
		gpios = <102 0>;
		output-high;
	};
};

&qupv3_se6_spi {
	status = "okay";
	spidev0: spidev@0 {
		compatible = "qcom,spi-msm-codec-slave";
		reg =<0>;
		spi-max-frequency = <50000000>;
	};
};

&stm {
	status = "disabled";
};

&gcc {
	/delete-property/ protected-clocks;
};

&thermal_zones {
	sdr1_pa {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&qmi_sensor
				(QMI_MODEM_INST_ID+QMI_SDR1_PA)>;
		trips {
			thermal-engine-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};

	sdr1 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&qmi_sensor
				(QMI_MODEM_INST_ID+QMI_SDR1)>;
		trips {
			thermal-engine-config0 {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};
		};
	};
};
