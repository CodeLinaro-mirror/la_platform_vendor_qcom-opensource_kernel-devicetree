#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/qcom,gcc-sdxpinn.h>

&tlmm {
	emac {
		emac0_pin_rgmii_txc: emac0_pin_rgmii_txc {
			mux {
				pins = "gpio82";
				function = "RGMII_TXC";
			};

			config {
				pins = "gpio82";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				output-high;
			};
		};

		emac0_pin_rgmii_txd0: emac0_pin_rgmii_txd0 {
			mux {
				pins = "gpio83";
				function = "RGMII_TXD0";
			};

			config {
				pins = "gpio83";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				output-high;
			};
		};

		emac0_pin_rgmii_txd1: emac0_pin_rgmii_txd1 {
			mux {
				pins = "gpio84";
				function = "RGMII_TXD1";
			};

			config {
				pins = "gpio84";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				output-high;
			};
		};

		emac0_pin_rgmii_txd2: emac0_pin_rgmii_txd2 {
			mux {
				pins = "gpio85";
				function = "RGMII_TXD2";
			};

			config {
				pins = "gpio85";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				output-high;
			};
		};

		emac0_pin_rgmii_txd3: emac0_pin_rgmii_txd3 {
			mux {
				pins = "gpio86";
				function = "RGMII_TXD3";
			};

			config {
				pins = "gpio86";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				output-high;
			};
		};

		emac0_pin_rgmii_tx_ctl: emac0_pin_rgmii_tx_ctl {
			mux {
				pins = "gpio87";
				function = "RGMII_TX_CTL";
			};

			config {
				pins = "gpio87";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				output-high;
			};
		};

		emac0_pin_rgmii_rxc: emac0_pin_rgmii_rxc {
			mux {
				pins = "gpio88";
				function = "RGMII_RXC";
			};

			config {
				pins = "gpio88";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				input-enable;
			};
		};

		emac0_pin_rgmii_rxd0: emac0_pin_rgmii_rxd0 {
			mux {
				pins = "gpio89";
				function = "RGMII_RXD0";
			};

			config {
				pins = "gpio89";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				input-enable;
			};
		};

		emac0_pin_rgmii_rxd1: emac0_pin_rgmii_rxd1 {
			mux {
				pins = "gpio90";
				function = "RGMII_RXD1";
			};

			config {
				pins = "gpio90";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				input-enable;
			};
		};

		emac0_pin_rgmii_rxd2: emac0_pin_rgmii_rxd2 {
			mux {
				pins = "gpio91";
				function = "RGMII_RXD2";
			};

			config {
				pins = "gpio91";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				input-enable;
			};
		};

		emac0_pin_rgmii_rxd3: emac0_pin_rgmii_rxd3 {
			mux {
				pins = "gpio92";
				function = "RGMII_RXD3";
			};

			config {
				pins = "gpio92";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				input-enable;
			};
		};

		emac0_pin_rgmii_rx_ctl: emac0_pin_rgmii_rx_ctl {
			mux {
				pins = "gpio93";
				function = "RGMII_RX_CTL";
			};

			config {
				pins = "gpio93";
				drive-strength = <8>; /* 8 mA */
				bias-disable; /* NO PULL*/
				input-enable;
			};
		};

	};
};


&soc {
	vreg_emac_phy: vreg_emac_phy {
		compatible = "qti-regulator-fixed";
		regulator-name = "vreg_emac_phy";
		gpio = <&tlmm 105 GPIO_ACTIVE_HIGH>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
		regulator-enable-ramp-delay = <10000>;
	};

	mtl_rx_setup: rx-queues-config {
		snps,rx-queues-to-use = <4>;
		snps,rx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			snps,route-up;
			snps,threshold_byte = <64>;
			qcom,ipa_offload;
			snps,map-to-dma-channel = <0x1>;
		};

		queue1 {
			snps,dcb-algorithm;
			snps,map-to-dma-channel = <0x1>;
			snps,route-ptp;
		};

		queue2 {
			snps,avb-algorithm;
			snps,map-to-dma-channel = <0x2>;
			snps,route-avcp;
		};

		queue3 {
			snps,avb-algorithm;
			snps,map-to-dma-channel = <0x3>;
			snps,priority = <0xC>;
		};
	};

	mtl_tx_setup: tx-queues-config {
		snps,tx-queues-to-use = <4>;
		snps,tx-sched-sp;

		queue0 {
			snps,dcb-algorithm;
			qcom,ipa_offload;
		};

		queue1 {
			snps,dcb-algorithm;
		};

		queue2 {
			snps,avb-algorithm;
			snps,send_slope = <0x1000>;
			snps,idle_slope = <0x1000>;
			snps,high_credit = <0x3E800>;
			snps,low_credit = <0xFFC18000>;
		};

		queue3 {
			snps,avb-algorithm;
			snps,send_slope = <0x1000>;
			snps,idle_slope = <0x1000>;
			snps,high_credit = <0x3E800>;
			snps,low_credit = <0xFFC18000>;
		};
	};
};

&ethqos_hw1 {
		pinctrl-names = "dev-emac0_pin_rgmii_txc",
			"dev-emac0_pin_rgmii_txd0", "dev-emac0_pin_rgmii_txd1",
			"dev-emac0_pin_rgmii_txd2", "dev-emac0_pin_rgmii_txd3",
			"dev-emac0_pin_rgmii_tx_ctl","dev-emac0_pin_rgmii_rxc",
			"dev-emac0_pin_rgmii_rxd0", "dev-emac0_pin_rgmii_rxd1",
			"dev-emac0_pin_rgmii_rxd2", "dev-emac0_pin_rgmii_rxd3",
			"dev-emac0_pin_rgmii_rx_ctl", "dev-emac0_mdc",
			"dev-emac0_mdio";

		pinctrl-0 = <&emac0_pin_rgmii_txc>;
		pinctrl-1 = <&emac0_pin_rgmii_txd0>;
		pinctrl-2 = <&emac0_pin_rgmii_txd1>;
		pinctrl-3 = <&emac0_pin_rgmii_txd2>;
		pinctrl-4 = <&emac0_pin_rgmii_txd3>;
		pinctrl-5 = <&emac0_pin_rgmii_tx_ctl>;
		pinctrl-6 = <&emac0_pin_rgmii_rxc>;
		pinctrl-7 = <&emac0_pin_rgmii_rxd0>;
		pinctrl-8 = <&emac0_pin_rgmii_rxd1>;
		pinctrl-9 = <&emac0_pin_rgmii_rxd2>;
		pinctrl-10 = <&emac0_pin_rgmii_rxd3>;
		pinctrl-11 = <&emac0_pin_rgmii_rx_ctl>;
		pinctrl-12 = <&emac0_mdc>;
		pinctrl-13 = <&emac0_mdio>;

		clocks =<&gcc GCC_EEE_EMAC0_CLK>,
			<&gcc GCC_EMAC0_AXI_CLK>,
			<&gcc GCC_EMAC0_CC_SGMIIPHY_RX_CLK>,
			<&gcc GCC_EMAC0_CC_SGMIIPHY_TX_CLK>,
			<&gcc GCC_EMAC0_PHY_AUX_CLK>,
			<&gcc GCC_EMAC0_PTP_CLK>,
			<&gcc GCC_EMAC0_RGMII_CLK>,
			<&gcc GCC_EMAC0_RPCS_RX_CLK>,
			<&gcc GCC_EMAC0_RPCS_TX_CLK>,
			<&gcc GCC_EMAC0_SLV_AHB_CLK>,
			<&gcc GCC_EMAC0_XGXS_RX_CLK>,
			<&gcc GCC_EMAC0_XGXS_TX_CLK>,
			<&gcc GCC_EMAC0_CC_SGMIIPHY_RX_CLK_SRC>,
			<&gcc GCC_EMAC0_CC_SGMIIPHY_TX_CLK_SRC>,
			<&gcc GCC_EMAC0_SGMIIPHY_MAC_RCLK_SRC>,
			<&gcc GCC_EMAC0_SGMIIPHY_MAC_TCLK_SRC>,
			<&emac0_sgmiiphy_rclk>,
			<&emac0_sgmiiphy_tclk>,
			<&emac0_sgmiiphy_mac_rclk>,
			<&emac0_sgmiiphy_mac_tclk>,
			<&gcc GCC_EMAC_0_CLKREF_EN>;
		clock-names = "eee", "stmmaceth", "sgmii_rx",
		"sgmii_tx", "phyaux","ptp_ref", "rgmii",
		"pcs_rx", "pcs_tx", "pclk", "xgxs_rx",
		"xgxs_tx", "sgmii_rclk_src", "sgmii_tclk_src",
		"sgmii_mac_rclk_src", "sgmii_mac_tclk_src", "sgmii_rclk",
		"sgmii_tclk", "sgmii_mac_rclk", "sgmii_mac_tclk","sgmi_ref";

		snps,ptp-ref-clk-rate = <230400000>;
		snps,ptp-req-clk-rate = <125000000>;
		avb-vlan-id = <2>;

		vreg_emac_phy-supply = <&vreg_emac_phy>;
		/delete-property/ snps,reset-gpio;
		snps,reset-gpio = <&tlmm 75 GPIO_ACTIVE_LOW>;
		snps,reset-delays-us = <1000 10000 1000>;
		snps,mtl-rx-config = <&mtl_rx_setup>;
		snps,mtl-tx-config = <&mtl_tx_setup>;

		resets = <&gcc GCC_EMAC0_RGMII_CLK_ARES>;
		reset-names = "emac0_rgmii_clk_ares";
		phy-mode = "rgmii-rxid";
		mac-mode = "rgmii-rxid";
		managed = "auto";
		eth-c22-mdio-probe;

		snps,phy1_reset-gpio = <&tlmm 96 GPIO_ACTIVE_LOW>;
		snps,phy1-reset-delays-us = <1000 100000 221000>;


		qcom,ioss_auto_resume_disabled;
		emac-phy-off-suspend = <4>;
		fixed-link {
			status = "disabled";
			speed = <2500>;
			full-duplex;
		};

		rgmii-io-macro-info-hsr {
			rgmii-io-macro-config = <0x40c04c03>;
			rgmii-io-macro-config2 = <0x2200a0>;
			sdcc-hc-reg-dll-config = <0xd642c>;
			sdcc-hc-reg-ddr-config = <0x80040868>;
			sdcc-hc-reg-dll-config2 = <0xa001>;
			sdcc-usr-ctl = <0x90106c0>;
			sdcc-test-ctl = <0x01400000>;
		};
};

&qupv3_se0_spi {
status = "ok";

#address-cells = <1>;
#size-cells = <0>;

	can-controller@0 {
		compatible = "qcom,nxp,mpc5746c";
		reg = <0>;
		interrupt-parent = <&tlmm>;
		interrupts = <51 0>;
		spi-max-frequency = <5000000>;
		qcom,clk-freq-mhz = <40000000>;
		qcom,max-can-channels = <1>;
		qcom,bits-per-word = <8>;
		qcom,support-can-fd;
	};
};

&pmx75_vbus_detect {
	status = "ok";
};

&pmx75_eusb2_repeater {
	vdd18-supply = <&pmx75_l5>;
	vdd3-supply = <&pmx75_l10>;
	status = "ok";
};

&eusb2_phy {
	dummy-supply = <&pmx75_eusb2_repeater>;
	usb-repeater = <&pmx75_eusb2_repeater>;
};

&usb {
	extcon = <&pmx75_vbus_detect>;
};

&sdhc_2 {
	status = "ok";

	vdd-supply = <&vreg_sdc2_sd_vdd>;
	qcom,vdd-voltage-level = <2950000 2950000>;
	qcom,vdd-current-level = <0 800000>;

	vdd-io-supply = <&vreg_sdc2_sd_ls_vccb>;
	qcom,vdd-io-voltage-level = <2850000 2850000>;
	qcom,vdd-io-current-level = <0 22000>;

	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_on>;
	pinctrl-1 = <&sdc2_off>;

	cd-gpios = <&tlmm 103 GPIO_ACTIVE_LOW>;
};
