
&pcie0 {
	status = "disabled";
};

&pcie0_msi {
	status = "disabled";
};

&pcie1 {
	status = "disabled";
};

&pcie2 {
	status = "ok";
};

&pcie2_msi {
	status = "ok";
};

&pcie_ep {
	qcom,pcie-device-id = /bits/ 16 <0x030a>;
	qcom,override-disable-sriov;
	status = "ok";
};

&mhi_device {
	qcom,mhi-ifc-id = <0x030a17cb>;
	status = "ok";
};

&mhi_net_device {
	qcom,mhi-ethernet-interface-ch-list = <46>;
	status = "ok";
};

&mhi_dev_qrtr {
	status = "ok";
};

&usb {
	dwc3@a600000 {
		qcom,iommu-dma = "bypass";
	};
};
