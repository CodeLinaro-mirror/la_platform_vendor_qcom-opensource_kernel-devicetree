&reserved_memory {
	tele_vm_mem: tele_vm_region@55200000 {
		no-map;
		reg = <0x0 0x55200000 0x0 0x5000000>;
	};

	tele_vm_swiotlb: tele_vm_swiotlb@5A210000 {
		no-map;
		reg = <0x0 0x5A210000 0x0 0x200000>;
		gunyah-label = <0x11>;
	};

	tele_vm_vblk0_ring: tele_vm_vblk0_ring@5A200000 {
		no-map;
		reg = <0x0 0x5A200000 0x0 0x4000>;
		gunyah-label = <0x12>;
	};

	tele_vm_vnet0_ring: tele_vm_vnet0_ring@5A204000 {
		no-map;
		reg = <0x0 0x5A204000 0x0 0xC000>;
		gunyah-label = <0x13>;
	};
};

&qcom_tzlog {
	qcom,hyplog-enabled;
	hyplog-address-offset = <0x410>;
	hyplog-size-offset = <0x414>;
};

&soc {
	gh-secure-vm-loader@0 {
		compatible = "qcom,gh-secure-vm-loader";
		qcom,pas-id = <28>;
		qcom,vmid = <45>;
		qcom,firmware-name = "televm";
		memory-region = <&tele_vm_mem>;
		virtio-backends = <&tele_vm_virt_be0 &tele_vm_virt_be1>;
	};

	tele_vm: qcom,tele_vm@5A200000 {
		reg = <0x5A200000 0x210000>;
		vm_name = "televm";
		shared-buffers = <&tele_vm_vblk0_ring &tele_vm_vnet0_ring &tele_vm_swiotlb>;
	};

	tele_vm_virt_be0:virtio_backend@12 {
		compatible = "qcom,virtio_backend";
		qcom,vm = <&tele_vm>;
		qcom,label = <0x12>;
	};

	tele_vm_virt_be1:virtio_backend@13 {
		compatible = "qcom,virtio_backend";
		qcom,vm = <&tele_vm>;
		qcom,label = <0x13>;
	};

	qcom,tele_vm-vsock-msgq {
		compatible = "qcom,gunyah-vsock";
		msgq-label = <0x14>;
	};
};
