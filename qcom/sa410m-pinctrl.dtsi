	emac {

		emac_mdc: emac_mdc {
			mux {
				pins = "gpio136";
				function = "RGMII0_MDC";
			};

			config {
				pins = "gpio136";
				bias-pull-down;
				enable-input = <0>;
				drive-strength = <16>;
			};
		};

		emac_mdio: emac_mdio {
			mux {
				pins = "gpio135";
				function = "RGMII0_MDIO";
