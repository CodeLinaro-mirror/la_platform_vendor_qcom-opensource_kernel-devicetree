#include <dt-bindings/thermal/thermal_qti.h>

&soc {
	tsens0: thermal-sensor@c271000 {
		compatible = "qcom,tsens-v2";
		reg = <0x0c271000 0x1ff>, /* TM */
			<0x0c222000 0x1ff>; /* SROT */
		#qcom,sensors = <16>;
		interrupts = <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "uplow","critical";
		#thermal-sensor-cells = <1>;
	};

	qcom,cpufreq-cdev {
		compatible = "qcom,cpufreq-cdev";
		qcom,cpus = <&CPU0>;
	};
};

#include "sdxbaagha-thermal-modem.dtsi"

&thermal_zones {
	aoss-0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 0>;
		trips {
			thermal-engine-config {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	cpuss-0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 1>;
		trips {
			thermal-engine-config {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	mdmq6-0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 2>;
		trips {
			thermal-engine-config {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	ctile {
		polling-delay-passive = <10>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 3>;
		trips {
			thermal-engine-config {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};

	mdmss-0 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 4>;
		trips {
			thermal-engine-config {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			mdmss0_config0: mdmss0-config0 {
				temperature = <95000>;
				hysteresis = <3000>;
				type = "active";
			};

			mdmss0_config1: mdmss0-config1 {
				temperature = <98000>;
				hysteresis = <3000>;
				type = "active";
			};

			mdmss0_config2: mdmss0-config2 {
				temperature = <100000>;
				hysteresis = <2000>;
				type = "active";
			};

			mdmss0_config3: mdmss0-config3 {
				temperature = <102000>;
				hysteresis = <2000>;
				type = "active";
			};

			mdmss0_config4: mdmss0-config4 {
				temperature = <102000>;
				hysteresis = <3000>;
				type = "active";
			};

			mdmss0_config5: mdmss0_config5 {
				temperature = <105000>;
				hysteresis = <3000>;
				type = "active";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};

		cooling-maps {
			lte_cdev0 {
				trip = <&mdmss0_config0>;
				cooling-device = <&modem_lte_dsc 1 1>;
			};

			nr_1rx_cdev0 {
				trip = <&mdmss0_config0>;
				cooling-device = <&modem_nr_1rx_dsc 1 1>;
			};

			nr_2rx_cdev0 {
				trip = <&mdmss0_config0>;
				cooling-device = <&modem_nr_2rx_dsc 1 1>;
			};

			nr_2rx_cdev2 {
				trip = <&mdmss0_config1>;
				cooling-device = <&modem_nr_2rx_dsc 2 2>;
			};

			nr_1rx_cdev2 {
				trip = <&mdmss0_config4>;
				cooling-device = <&modem_nr_1rx_dsc 254 254>;
			};

			lte_cdev2 {
				trip = <&mdmss0_config5>;
				cooling-device = <&modem_lte_dsc 255 255>;
			};

			nr_2rx_cdev4 {
				trip = <&mdmss0_config2>;
				cooling-device = <&modem_nr_2rx_dsc 3 3>;
			};

			nr_1rx_cdev4 {
				trip = <&mdmss0_config5>;
				cooling-device = <&modem_nr_1rx_dsc 255 255>;
			};

			nr_2rx_cdev8 {
				trip = <&mdmss0_config3>;
				cooling-device = <&modem_nr_2rx_dsc 254 254>;
			};

			nr_2rx_cdev10 {
				trip = <&mdmss0_config0>;
				cooling-device = <&modem_nr_2rx_dsc 255 255>;
			};
		};
	};

	mdmss-1 {
		polling-delay-passive = <0>;
		polling-delay = <0>;
		thermal-sensors = <&tsens0 5>;
		trips {
			thermal-engine-config {
				temperature = <125000>;
				hysteresis = <1000>;
				type = "passive";
			};

			reset-mon-cfg {
				temperature = <115000>;
				hysteresis = <5000>;
				type = "passive";
			};
		};
	};
};

